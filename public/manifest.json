{
  "manifest_version": 3,
  "name": "WaveNest",
  "version": "1.0.0",
  "description": "A radio and podcast companion for Chrome with Ethiopia-first picks, international hits, and an in-extension player.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen", "sidePanel"],
  "host_permissions": [
    "https://*.api.radio-browser.info/*",
    "https://anchor.fm/*",
    "https://podcasts.files.bbci.co.uk/*",
    "https://feeds.npr.org/*",
    "https://feeds.megaphone.fm/*",
    "https://feed.syntax.fm/*",
    "https://feeds.simplecast.com/*",
    "https://rss2.flightcast.com/*",
    "https://www.omnycontent.com/*",
    "https://feeds.acast.com/*",
    "https://feeds.captivate.fm/*",
    "https://as-hls-ww-live.akamaized.net/*",
    "https://media-ice.musicradio.com/*",
    "https://stream-al.hellorayo.co.uk/*",
    "https://learningenglish.voanews.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "WaveNest",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open the WaveNest side panel"
    }
  }
}
